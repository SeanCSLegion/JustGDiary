<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 应用内从 GitHub Releases 检查并下载 APK；最终安装由 Android 系统确认。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 定位：有 GMS 走 FusedLocationProviderClient，无 GMS 退原生 LocationManager（见方案 §8.1） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 每日提醒（WorkManager 投递通知，API 33+ 需运行时授权） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        P0-2（2026-11-12 用户确认）：关闭系统 Auto Backup，备份只走设置页导出的 .jdiary。
        Android 的 25MB 配额无法同时装下数据库 + 图片，容易出现“有日记、图没了”的半套恢复；
        设备迁移/恢复请使用应用内导出。
    -->
    <application
        android:name=".JustDiaryApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.JustDiary">

        <!--
            singleTop：深链必须交给**同一个** Activity 实例处理。
            默认的 standard 模式下，"日记页已打开时再点一条深链"会新建一个实例：
            `LaunchIntent` 是进程级单例，新旧两个 `RootScreen` 都会观察并消费它，
            结果是新实例常常拿到已被清空的 key —— 实测表现为"第二次深链把日记页关掉、回到首页"。
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.JustDiary"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 深链：justdiary://editor?dayKey=YYYY-MM-DD（对齐 iOS CFBundleURLTypes，见方案 §8.4） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="justdiary"
                    android:host="editor" />
                <!-- P1-9：快捷方式「搜索日记」 -->
                <data
                    android:scheme="justdiary"
                    android:host="search" />
            </intent-filter>

            <!-- P1-9：长按图标的两个静态快捷方式（写今天 / 搜索日记） -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- P1-7：时区 / 系统时间变化后重排提醒（WorkManager 的延迟按旧时钟算） -->
        <receiver
            android:name=".service.ReminderTimeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- 分享长图与备份包：把私有目录里的文件暴露成可授权的 content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
